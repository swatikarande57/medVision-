# =============================================================================
# MedVision AI — Environment Variables (copy to .env and fill in values)
# NEVER commit .env to version control
# =============================================================================

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=medvision
DB_USERNAME=medvision_app
DB_PASSWORD=change_me_strong_password
MYSQL_ROOT_PASSWORD=change_me_root_password

# --- Spring Boot Backend ---
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
JWT_SECRET=change_me_use_at_least_256_bits_random_secret
JWT_ACCESS_EXPIRY_MINUTES=30
JWT_REFRESH_EXPIRY_DAYS=7
CORS_ALLOWED_ORIGINS=http://localhost:5173
ALLOW_PUBLIC_REGISTRATION=true
UPLOAD_DIR=./uploads

# --- AI Service ---
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=change_me_shared_api_key
AI_SERVICE_PORT=8000
AI_INFERENCE_DEVICE=cpu

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_WS_URL=http://localhost:8080/ws
